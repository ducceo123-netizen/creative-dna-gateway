{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "brand",
    "version",
    "releaseStatus",
    "sources",
    "rules",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "brand": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "releaseStatus": {
      "enum": [
        "pilot",
        "review",
        "approved"
      ]
    },
    "coverage": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "record",
          "screenshot",
          "viewport",
          "capturedAt",
          "visualCheck"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "record": {
            "type": "string"
          },
          "screenshot": {
            "type": "string"
          },
          "viewport": {
            "type": "object"
          },
          "capturedAt": {
            "type": "string"
          },
          "visualCheck": {
            "enum": [
              "pass",
              "suspect",
              "not-reviewed"
            ]
          },
          "provenanceNote": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "scope",
          "status",
          "confidence",
          "statement",
          "value",
          "evidence",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "identity",
              "style",
              "ui"
            ]
          },
          "scope": {
            "enum": [
              "brand-specific",
              "shared-ecommerce",
              "product-category",
              "campaign"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "inferred",
              "proposed",
              "unknown"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "statement": {
            "type": "string"
          },
          "value": {},
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "pointer"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "observed",
                    "inferred"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "visualAcceptance": {
      "type": "object",
      "required": [
        "ownerDecision",
        "dimensions"
      ],
      "properties": {
        "ownerDecision": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "status",
              "evidence",
              "rationale"
            ],
            "properties": {
              "dimension": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "aligned",
                  "deliberate-adaptation",
                  "mismatch",
                  "unknown",
                  "untested"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}